# Copy to .dev.vars for local admin + API testing:
#   cp .dev.vars.example .dev.vars
#
# Then run: npm run dev
# Open: http://localhost:8788/admin/analytics.html

ADMIN_API_KEY=replace-with-a-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=5372

# Optional — needed for orders/analytics data after login
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# For admin delete without extra SQL policies (recommended on Cloudflare only):
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
